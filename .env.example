# Thothly — environment variables
#
# Copy this file to `.env` before running `docker-compose up`:
#     cp .env.example .env
#
# All variables are optional in V1 scaffolding (the /health endpoint
# does not depend on any of them). They become required as later
# tickets land — kept here so self-hosters know what to fill in.

# -----------------------------------------------------------------
# Mistral API
# -----------------------------------------------------------------
# Used for:
#   - Mistral Small  — light transcript cleanup (punctuation,
#                      filler-word removal, paragraph segmentation)
#   - Voxtral        — fallback transcription for YouTube videos
#                      that ship without native subtitles
#
# Get a key at https://console.mistral.ai/
# V1 scaffolding ignores this value; it is wired in when the
# cleanup and Voxtral tickets land.
MISTRAL_API_KEY=

# -----------------------------------------------------------------
# Backend URL (frontend → backend)
# -----------------------------------------------------------------
# Override only if you run the frontend outside Docker Compose
# (e.g. `pnpm dev` on your host pointing at a remote backend).
# Inside docker-compose this is set to http://backend:8000 via the
# compose file and you do NOT need to set it here.
# BACKEND_URL=http://localhost:8000
