        }
      }
    },
    "/jobs/{job_id}/confirm": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Confirm Job",
        "operationId": "confirm_job_jobs__job_id__confirm_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
