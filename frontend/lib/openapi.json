    "/jobs/{job_id}/stop": {
      "post": {
        "tags": [
          "jobs"
        ],
        "summary": "Stop Job",
        "description": "Stop a running compile before its next item or AI call; the book keeps\nwhat's ready.",
        "operationId": "stop_job_jobs__job_id__stop_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
