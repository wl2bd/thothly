          },
          "transcript_lang": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transcript Lang"
          },
          "is_punctuated": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Is Punctuated"
          },
          "word_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Word Count"
          },
          "reading_time_min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reading Time Min"
          },
          "uncertain": {
            "type": "boolean",
            "title": "Uncertain",
            "default": false
          },
          "set_aside": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Set Aside"
          },
          "id": {
            "type": "string",
            "title": "Id"
          },
          "selected": {
            "type": "boolean",
            "title": "Selected",
            "default": false
          },
          "compile_state": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "pending",
                  "compiling",
                  "done",
                  "skipped",
                  "failed"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Compile State"
          },
          "compile_note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compile Note"
          }
        },
        "type": "object",
        "required": [
          "title",
          "url",
          "item_type",
          "source_index",
          "item_index",
          "id"
        ],
        "title": "DiscoveredItemResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemPreview": {
        "properties": {
          "item_id": {
            "type": "string",
            "title": "Item Id"
          },
          "item_type": {
            "type": "string",
            "enum": [
              "youtube",
              "blog",
              "podcast"
            ],
            "title": "Item Type"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "content_md": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Md"
          },
          "truncated": {
            "type": "boolean",
            "title": "Truncated",
            "default": false
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "item_type",
          "available"
        ],
        "title": "ItemPreview",
        "description": "The no-LLM content a discovered item would contribute, for the review\nscreen. Mirrors the compiler's zero-LLM path exactly, so `content_md` is what\nactually lands in the EPUB when no AI cleanup role is chosen — not a guess.\n\n`available` is False when there's nothing free to show (a podcast awaiting\ntranscription, a video without subtitles, an unscrapable page); `note` then\nexplains why. `note` is also set on an *available* preview to flag a caveat\n(e.g. raw captions the final compile would punctuate). `truncated` marks a\nlong body clipped for transport — the compile still uses the full text."
      },
      "JobConfirm": {
        "properties": {
          "selected_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Selected Ids"
          },
          "book_title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Book Title"
          },
          "llm_roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Llm Roles",
            "default": []
          },
          "llm": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VisitorEndpoint"
              },
              {
                "type": "null"
              }
            ]
          },
          "stt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VisitorEndpoint"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "selected_ids"
        ],
        "title": "JobConfirm"
      },
      "JobCreate": {
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceSpec"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Sources"
          },
          "book_title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Book Title"
          }
        },
        "type": "object",
        "required": [
          "sources"
        ],
        "title": "JobCreate"
      },
      "JobResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "discovering",
              "reviewing",
              "processing",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "book_title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Book Title"
          },
          "title_named": {
            "type": "boolean",
            "title": "Title Named",
            "default": false
          },
          "epub_bytes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Epub Bytes"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "discovered_items": {
            "items": {
              "$ref": "#/components/schemas/DiscoveredItemResponse"
            },
            "type": "array",
            "title": "Discovered Items",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "status",
          "sources",
          "created_at",
          "updated_at"
        ],
        "title": "JobResponse"
      },
      "LLMConfig": {
        "properties": {
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "stt_available": {
            "type": "boolean",
            "title": "Stt Available"
          },
          "podcast_transcripts": {
            "type": "boolean",
            "title": "Podcast Transcripts"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/RoleInfo"
            },
            "type": "array",
            "title": "Roles"
          },
          "pricing": {
            "$ref": "#/components/schemas/Pricing"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderInfo"
            },
            "type": "array",
            "title": "Providers"
          },
          "custom_base_url_allowed": {
            "type": "boolean",
            "title": "Custom Base Url Allowed"
          }
        },
        "type": "object",
        "required": [
          "available",
          "stt_available",
          "podcast_transcripts",
          "roles",
          "pricing",
          "providers",
          "custom_base_url_allowed"
        ],
        "title": "LLMConfig"
      },
      "Pricing": {
        "properties": {
          "stt_per_minute": {
            "type": "number",
            "title": "Stt Per Minute"
          },
          "llm_per_mtok_in": {
            "type": "number",
            "title": "Llm Per Mtok In"
          },
          "llm_per_mtok_out": {
            "type": "number",
            "title": "Llm Per Mtok Out"
          }
        },
        "type": "object",
        "required": [
          "stt_per_minute",
          "llm_per_mtok_in",
          "llm_per_mtok_out"
        ],
        "title": "Pricing",
        "description": "Approximate provider rates (USD) for the review screen's cost estimate.\nInformational only — Thothly never bills anything."
      },
      "ProviderBatch": {
        "properties": {
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            },
            "type": "array",
            "title": "Results"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "results"
        ],
        "title": "ProviderBatch",
        "description": "One provider's share of a streamed search, sent as soon as it finishes.\n\n`error` is set when the provider failed or timed out; its results are then\nempty and the other providers' batches still arrive."
      },
      "ProviderInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "llm_per_mtok_in": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Per Mtok In"
          },
          "llm_per_mtok_out": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Per Mtok Out"
          },
          "stt_per_minute": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stt Per Minute"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "llm_per_mtok_in",
          "llm_per_mtok_out",
          "stt_per_minute"
        ],
        "title": "ProviderInfo",
        "description": "An allowlisted provider for the connect dialog. No base URL: the browser\nnames a provider and the server alone knows where it lives."
      },
      "RoleInfo": {
        "properties": {
          "id": {
            "type": "string",
