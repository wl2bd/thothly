    },
    "/jobs/{job_id}/items/{item_id}/preview": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Preview Item",
        "description": "The no-LLM content this item would contribute, for the review screen.\n\nLets the user see what they're keeping before compiling — the exact\nzero-LLM render (free/instant for cached YouTube transcripts, one cheap\nscrape for blogs; podcasts report that they need transcription first).",
        "operationId": "preview_item_jobs__job_id__items__item_id__preview_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Item Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemPreview"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{job_id}/download": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Download Job",
        "description": "The finished compilation, as EPUB or as plain Markdown.",
        "operationId": "download_job_jobs__job_id__download_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "epub",
                "md"
              ],
              "type": "string",
              "default": "epub",
              "title": "Format"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/llm": {
      "get": {
        "tags": [
          "llm"
        ],
        "summary": "Get Llm Config",
        "description": "Tell the review screen which AI passes are configured and what they cost.\n\n`available`/`stt_available` are False when no endpoint is set; the frontend\nthen shows the roles disabled and skips that part of the estimate. The role\ncatalogue is the single source of truth from app/pipeline/roles.py; pricing\ncomes from config so a self-hoster can match their provider.",
        "operationId": "get_llm_config_llm_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LLMConfig"
                }
              }
            }
          }
        }
      }
    },
    "/llm/verify": {
      "post": {
        "tags": [
          "llm"
        ],
        "summary": "Verify Key",
        "description": "Check a visitor's key and list the models it grants, before they save it.\n\nGoes through the backend because providers don't allow browser calls\n(CORS), and only ever to an allowlisted provider's own URL. The key is used\nfor this one call and never stored or echoed.",
        "operationId": "verify_key_llm_verify_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/search/stream": {
      "get": {
        "tags": [
          "search"
        ],
        "summary": "Search Stream",
        "description": "Multi-provider search, streamed: one JSON line per provider (NDJSON), each\nsent the moment that provider answers, so fast sources show up without\nwaiting for the slowest. A line is a `ProviderBatch`. A blank query sends\nnothing, so the frontend can call it while the visitor is still typing.\n\nThe browser's Accept-Language localizes YouTube's fallback titles the way an\nanonymous visit would.",
        "operationId": "search_stream_search_stream_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Free-text search query",
              "default": "",
              "title": "Q"
            },
            "description": "Free-text search query"
          },
          {
            "name": "accept-language",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Accept-Language"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One ProviderBatch per line (NDJSON).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderBatch"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DiscoveredItemResponse": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "item_type": {
            "type": "string",
            "enum": [
              "youtube",
              "blog",
              "podcast"
            ],
            "title": "Item Type"
          },
          "source_index": {
            "type": "integer",
            "title": "Source Index"
          },
          "item_index": {
            "type": "integer",
            "title": "Item Index"
          },
          "estimated_duration_s": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Duration S"
          },
          "estimated_size_chars": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Estimated Size Chars"
          },
          "preview_html": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preview Html"
          },
          "feed_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Feed Url"
          },
          "has_transcript": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
