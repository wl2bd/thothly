        "https://thothly.vercel.app/r/checkbox.json",
        "https://thothly.vercel.app/r/dialog.json",
        "https://thothly.vercel.app/r/dropdown-menu.json",
        "https://thothly.vercel.app/r/input.json",
        "https://thothly.vercel.app/r/kbd.json",
        "https://thothly.vercel.app/r/label.json",
        "https://thothly.vercel.app/r/notice.json",
        "https://thothly.vercel.app/r/progress.json",
        "https://thothly.vercel.app/r/select.json",
        "https://thothly.vercel.app/r/sheet.json",
        "https://thothly.vercel.app/r/sonner.json",
        "https://thothly.vercel.app/r/spinner.json",
