    {
      "name": "gold-leaf",
      "type": "registry:style",
      "title": "Gold Leaf",
      "description": "Thothly's design system: the Gold Leaf theme, its two typefaces and every UI component.",
      "dependencies": [
        "tw-animate-css"
      ],
      "registryDependencies": [
        "https://thothly.vercel.app/r/gold-leaf-theme.json",
        "https://thothly.vercel.app/r/font-host-grotesk.json",
        "https://thothly.vercel.app/r/font-prociono.json",
        "https://thothly.vercel.app/r/accordion.json",
        "https://thothly.vercel.app/r/alert.json",
        "https://thothly.vercel.app/r/badge.json",
